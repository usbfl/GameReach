# 默认无需修改。以下空白项仅真实模式需要，由你填写。
DATA_MODE=fixtures
LLM_MODE=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_USE_TOOLS=true
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Steam 官方 https://steamcommunity.com/dev/apikey 的 Key；不是主页链接。修改后重启后端。
STEAM_WEB_API_KEY=
DATABASE_URL=sqlite:///./data/gamereach.db
DISPLAY_TIMEZONE=Asia/Taipei
MAX_PLANNING_ROUNDS=6
MAX_LLM_CALLS=18
MAX_TOOL_CALLS=15
MAX_EXTERNAL_REQUESTS=25
MAX_ACTIVE_SECONDS=180
MAX_CANDIDATES=20
MAX_INVESTIGATED_GAMES=5
MAX_RETRIES_PER_CALL=2
RUN_LIVE_TESTS=0
ENABLE_DEMO_CONTROLS=true
ENABLE_VERIFIER=true
DYNAMIC_ROUTING=true
MIN_COVERAGE=0.6
IGDB_MIN_INTERVAL=0.26
STEAM_MIN_INTERVAL=1
LLM_TIMEOUT_SECONDS=30

# DNA: initial details/reviews then at most two incremental follow-ups.
MAX_DNA_FOLLOWUP_ROUNDS=2

# 每款游戏：分层采样总上限 / 旧协议阅读上限。标签协议使用下方 TAG_* 独立设置。修改后重启。
MAX_REVIEWS_PER_GAME=120
REVIEW_CONTEXT_LIMIT=60
# 以下3项仅用于旧DNA协议兼容；新标签入口不使用这些准入门槛。
MIN_REVIEWS_FOR_RECOMMENDATION=20
MIN_CITED_REVIEWS=3
MIN_KNOWN_MECHANICS=3

# 玩家标签协议：独立于旧 DNA 的 MAX_CANDIDATES / MAX_INVESTIGATED_GAMES。
TAG_SCAN_LIMIT=500
TAG_CANDIDATE_LIMIT=80
TAG_INVESTIGATION_LIMIT=20
TAG_REVIEW_FETCH_LIMIT=36
TAG_REVIEW_BATCH_SIZE=4
TAG_REVIEW_BATCH_CHARS=16000
TAG_MAX_BATCHES_PER_GAME=3
# 期望推荐1–10款在界面选择。上述是上限，不代表每次都会达到；不自动增加付费预算。

# v0.10.2: local reuse (does not change model selection or budget ceilings)
REUSE_ENABLED=true
REUSE_TTL_SECONDS=86400
SOURCE_CATALOG_TTL_SECONDS=21600
SOURCE_DETAILS_TTL_SECONDS=21600
SOURCE_REVIEWS_TTL_SECONDS=1800
# Research strategy is chosen per task in the UI: quick / balanced / thorough.

# v0.11 interest groups: same game may appear under distinct themes
INTEREST_MIN_GAMES=3
INTEREST_MAX_GAMES=7
INTEREST_MAX_CARDS=6
